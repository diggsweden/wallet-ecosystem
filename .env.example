BASE_URL=https://localhost
VERIFIER_CLIENT_ID=localhost
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=password

# PKCS12 keystore/truststore passwords, one per ecosystem PKI artifact.
# These fixed values match the keystores already committed under config/certificates/,
# which is what lets CI just `cp .env.example .env` and go, with no cert generation
# step of its own. This is fine for a test project, but it does mean these values
# are effectively public (checked into git) — don't reuse them anywhere real.
#
# To rotate: run `bash config/certificates/generate_ecosystem_certs.sh` (it always
# generates brand-new random passwords into your local .env and regenerates the
# matching .p12/JWT files), then copy the new values from .env into this file and
# commit both together so CI stays in sync with what's actually committed.
# Not currently read by docker-compose.yaml: TRUST_VALIDATOR_TRUSTED_ISSUERS_PASSWORD,
# TRUST_VALIDATOR_TRUST_STORE_PASSWORD (no service mounts those truststores yet), but
# they're still required to regenerate them via generate_ecosystem_certs.sh.
PID_ISSUER_KEYSTORE_PASSWORD=pid_issuer_password
VERIFIER_KEYSTORE_PASSWORD=verifier_password
WALLET_PROVIDER_KEYSTORE_PASSWORD=wallet_provider_password
TRUST_SOURCE_KEYSTORE_PASSWORD=trust_source_password
TRUST_VALIDATOR_TRUSTED_ISSUERS_PASSWORD=trust_validator_trusted_issuers_password
TRUST_VALIDATOR_TRUST_STORE_PASSWORD=trust_validator_trust_store_password